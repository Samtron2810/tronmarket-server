# ── Required ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/tronmarket
JWT_SECRET=[SECURITY_DATA]
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Sessions (see services/authTokenService.js) ──────────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SECURE=           # set to 1 in production (https)
AUTH_COOKIE_SAMESITE=         # lax | strict | none
AUTH_MAX_SESSIONS=10

# ── Email (Resend; emails are skipped when unset) ────────────────────────
RESEND_API_KEY=
[SECURITY_DATA]"TronMarket <no-reply@example.com>"
PUBLIC_STORE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Pricing (services/pricingService.js) ─────────────────────────────────
SHIPPING_FREE_THRESHOLD=100000
PLATFORM_COMMISSION_RATE=0.10

# ── Social login (optional; enables POST /api/auth/google) ──────────────
GOOGLE_CLIENT_ID=

# ── Housekeeping jobs ────────────────────────────────────────────────────
IMAGE_CLEANUP_APPLY=            # set to 1 to let the weekly job DELETE orphaned Cloudinary images (dry-run otherwise)

# ── Uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
[SECURITY_DATA]

# ── Misc ────────────────────────────────────────────────────────────────
PORT=5000
REDIS_URL=                      # optional; caching/blacklist degrade gracefully without it
